python = find_program('python3')
proto_includes_link = custom_target(
  'proto_includes_link',
  output: 'include',
  command: [
    python,
    files('symlink_or_copy.py'),
    meson.current_source_dir(),
    '@OUTPUT@',
  ],
)
proto_includes_link_dep = declare_dependency(
  sources: proto_includes_link,
)

absl_log_initialize_dep = dependency('absl_log_initialize')

protoc_src = ['google/protobuf/compiler/main.cc']
protoc = executable(
  'protoc',
  sources: protoc_src,
  include_directories: [incdir, root_incdir, upb_incdir],
  dependencies: [
    dependency('threads'),
    absl_log_initialize_dep,
    proto_includes_link_dep,
    protoc_dep,
  ],
  install: should_install,
)

if meson.is_cross_build()
  # one huge monolithyc blow, will be splitten up eventually for native grpc plug-ins
  cc_native = meson.get_compiler(
    'cpp',
    native: true,
  )
  protoc_native = executable(
    'protoc-native',
    sources: [
      libutf8_range_src,
      libupb_src,
      libprotobuf_lite_src,
      libprotobuf_src,
      libprotoc_src,
      protoc_src,
    ],
    native: true,
    include_directories: [
      incdir,
      root_incdir,
      upb_incdir,
      utf8_incdir,
    ],
    dependencies: [
      dependency(
        'absl_base',
        native: true,
        default_options: ['cpp_std=c++17'],
      ),
      dependency(
        'absl_container',
        native: true,
      ),
      dependency(
        'absl_debugging',
        native: true,
      ),
      dependency(
        'absl_flags',
        native: true,
      ),
      dependency(
        'absl_hash',
        native: true,
      ),
      dependency(
        'absl_log',
        native: true,
      ),
      dependency(
        'absl_log_initialize',
        native: true,
      ),
      dependency(
        'absl_numeric',
        native: true,
      ),
      dependency(
        'absl_random',
        native: true,
      ),
      dependency(
        'absl_status',
        native: true,
      ),
      dependency(
        'absl_strings',
        native: true,
      ),
      dependency(
        'absl_synchronization',
        native: true,
      ),
      dependency(
        'absl_time',
        native: true,
      ),
      dependency(
        'threads',
        native: true,
      ),
      cc_native.find_library(
        'dbghelp',
        required: build_machine.system() == 'windows',
      ),
      proto_includes_link_dep,
    ],
  )
else
  protoc_native = protoc
endif

meson.override_find_program('protoc', protoc_native)

protoc_gen = generator(
  protoc_native,
  output: ['@BASENAME@.pb.cc', '@BASENAME@.pb.h'],
  arguments: ['@EXTRA_ARGS@', '--cpp_out=@BUILD_DIR@', '@INPUT@'],
)

