# Toggleable subsystems
option(
    'use_audio',
    type: 'feature',
    description: 'Enable the Audio subsystem',
)

option(
    'use_video',
    type: 'feature',
    description: 'Enable the Video subsystem',
)

option(
    'use_gpu',
    type: 'feature',
    description: 'Enable the GPU subsystem',
)

option(
    'use_render',
    type: 'feature',
    description: 'Enable the Renderer subsystem',
)

option(
    'use_camera',
    type: 'feature',
    description: 'Enable the Camery subsystem',
)

option(
    'use_joystick',
    type: 'feature',
    description: 'Enable the Joystick subsystem',
)

option(
    'use_haptic',
    type: 'feature',
    description: 'Enable the Haptic subsystem',
)

option(
    'use_hidapi',
    type: 'feature',
    description: 'Enable the HIDAPI subsystem',
)

option(
    'use_power',
    type: 'feature',
    description: 'Enable the Power subsystem',
)

option(
    'use_sensor',
    type: 'feature',
    description: 'Enable the Sensor subsystem',
)

option(
    'use_dialog',
    type: 'feature',
    description: 'Enable the Dialog subsystem',
)

option(
    'use_tray',
    type: 'feature',
    description: 'Enable the Tray subsystem',
)

option(
    'system_iconv',
    type: 'feature',
    description: 'Use iconv() from system-installed libraries',
)
option(
    'libiconv',
    type: 'boolean',
    description: 'Prefer iconv() from libiconv, if available, over libc version',
    value: false,
)
option(
    'use_gcc_atomics',
    type: 'feature',
    description: 'Use gcc builtin atomics',
)
option(
    'use_dbus',
    type: 'feature',
    description: 'Enable D-Bus support',
)
option(
    'use_audio_disk',
    type: 'feature',
    description: 'Support the disk writer audio driver',
)
option(
    'use_audio_dummy',
    type: 'feature',
    description: 'Support the dummy audio driver',
)
option(
    'use_audio_oss',
    type: 'feature',
    description: 'Support the OSS audio API',
)
option(
    'use_audio_alsa',
    type: 'feature',
    description: 'Support the ALSA audio API',
)
option(
    'use_audio_jack',
    type: 'feature',
    description: 'Support the JACK audio API',
)
option(
    'use_pipewire',
    type: 'feature',
    description: 'Use Pipewire audio',
)
option(
    'use_audio_pulseaudio',
    type: 'feature',
    description: 'Use PulseAudio',
)
option(
    'use_audio_sndio',
    type: 'feature',
    description: 'Use sndio audio API',
)
option(
    'use_directx',
    type: 'feature',
    description: 'Use DirectX for Windows audio/video',
)
option(
    'use_audio_wasapi',
    type: 'feature',
    description: 'Use the Windows WASAPI audio driver',
)
option(
    'use_hidapi_libusb',
    type: 'feature',
    description: 'Use libusb for low level joystick drivers',
)
